{
  "name": "zenathra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Yukasama",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "pnpm i && pnpm prisma && pnpm e2e:install",
    "------------CODE ANALYSIS------------": "",
    "eslint:fix": "eslint --fix src",
    "prettier": "prettier --write .",
    "sonar": "node scripts/sonar-scanner",
    "unused": "ts-unused-exports tsconfig.json --ignoreFiles=\"(page|layout|route)\\.(ts,tsx)?$|.*\\.config\\.(ts|js|mjs)$\" --excludePathsFromReport=src/app --excludePathsFromReport=components/ui --excludePathsFromReport=lib/fmp --excludePathsFromReport=middleware.ts --excludePathsFromReport=global-teardown.ts",
    "depcheck": "npx depcheck",
    "------------PLAYWRIGHT------------": "",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "e2e:report": "npx playwright show-report",
    "e2e:codegen": "npx playwright codegen localhost:3000",
    "e2e:install": "npx playwright install",
    "------------PRISMA------------": "",
    "prisma": "npx prisma generate",
    "prisma:db": "npx prisma generate && npx prisma db push",
    "prisma:studio": "npx prisma studio",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:db": "pnpm tsx scripts/migrate.mts",
    "------------OTHER------------": "",
    "kill": "npx kill-port 3000",
    "prepare": "husky"
  },
