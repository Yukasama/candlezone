  "scripts": {
    "dev": "next dev",
    "build": "pnpm prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "pnpm i && pnpm prisma && pnpm e2e:install",
    "------------CODE ANALYSIS------------": "",
    "eslint": "eslint --cache .",
    "prettier": "prettier --write .",
    "sonar": "node scripts/sonar-scanner",
    "depcheck": "npx depcheck",
    "------------JEST------------": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:istanbul": "pnpm t -- --coverage",
    "------------PLAYWRIGHT------------": "",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "e2e:report": "npx playwright show-report",
    "e2e:codegen": "npx playwright codegen localhost:3000",
    "e2e:install": "npx playwright install",
    "------------PRISMA------------": "",
    "prisma": "npx prisma generate",
    "prisma:push": "npx prisma generate && npx prisma db push",
    "prisma:studio": "npx prisma studio",
    "migrate:dev": "npx prisma migrate dev",
    "------------OTHER------------": "",
    "kill": "npx kill-port 3000"
  },
